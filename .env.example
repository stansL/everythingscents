# =============================================================================
# MULTI-PROVIDER PAYMENT SYSTEM CONFIGURATION
# =============================================================================
# This file contains configuration for M-Pesa, Airtel Money, and Paystack
# Copy this to .env.local and fill in your actual credentials
# =============================================================================

# =============================================================================
# M-PESA CONFIGURATION (Safaricom Daraja API)
# =============================================================================
# Get credentials from: https://developer.safaricom.co.ke/
# 
# For Sandbox Testing:
# - Consumer Key: Get from your sandbox app
# - Consumer Secret: Get from your sandbox app
# - Shortcode: 174379 (sandbox paybill)
# - Passkey: Get from Daraja portal (Test Credentials section)
# 
# For Production:
# - Apply for production credentials via Safaricom
# - Use your live business shortcode
# - Change MPESA_ENV to 'production'

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey_here
MPESA_CALLBACK_URL=https://yourdomain.com/api/webhooks/mpesa

# Sandbox values for testing (replace with production values):
# MPESA_ENV=production
# MPESA_SHORTCODE=your_live_paybill_or_till_number
# MPESA_CALLBACK_URL=https://yourproductiondomain.com/api/webhooks/mpesa

# =============================================================================
# AIRTEL MONEY CONFIGURATION
# =============================================================================
# Get credentials from: https://developers.airtel.africa/
# 
# For Staging/Testing:
# - Register on Airtel Developer Portal
# - Create an application
# - Get Client ID, Client Secret, and Merchant ID from dashboard
# 
# For Production:
# - Request production credentials via Airtel support
# - Change AIRTEL_ENV to 'production'

AIRTEL_ENV=staging
AIRTEL_CLIENT_ID=your_airtel_client_id_here
AIRTEL_CLIENT_SECRET=your_airtel_client_secret_here
AIRTEL_MERCHANT_ID=your_airtel_merchant_id_here
AIRTEL_CALLBACK_URL=https://yourdomain.com/api/webhooks/airtel

# Production values (replace when going live):
# AIRTEL_ENV=production
# AIRTEL_CALLBACK_URL=https://yourproductiondomain.com/api/webhooks/airtel

# =============================================================================
# PAYSTACK CONFIGURATION (Card Payments)
# =============================================================================
# Get credentials from: https://dashboard.paystack.com/
# Navigate to: Settings → API Keys & Webhooks
# 
# For Testing:
# - Use TEST keys (start with sk_test_ and pk_test_)
# - Test cards will work without actual charges
# 
# For Production:
# - Switch to LIVE keys (start with sk_live_ and pk_live_)
# - Configure webhook URL in Paystack dashboard

# Test Keys (for development):
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# Webhook Configuration:
PAYSTACK_CALLBACK_URL=https://yourdomain.com/api/webhooks/paystack

# Production Keys (replace when going live):
# PAYSTACK_SECRET_KEY=sk_live_your_live_secret_key_here
# PAYSTACK_PUBLIC_KEY=pk_live_your_live_public_key_here
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_live_public_key_here
# PAYSTACK_CALLBACK_URL=https://yourproductiondomain.com/api/webhooks/paystack

# =============================================================================
# PAYMENT PROVIDER FEATURE FLAGS (for client-side availability)
# =============================================================================
# These flags tell the frontend which payment methods to show
# Set to 'true' only if you have configured the provider above

NEXT_PUBLIC_ENABLE_MPESA=true
NEXT_PUBLIC_ENABLE_AIRTEL=true
# Paystack is auto-detected via NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Your application's public URL (used for generating callback URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production URL (replace when deploying):
# NEXT_PUBLIC_APP_URL=https://yourproductiondomain.com

# =============================================================================
# WEBHOOK TESTING WITH NGROK
# =============================================================================
# For local development, use ngrok to expose your webhooks:
# 
# 1. Install ngrok: npm install -g ngrok
# 2. Start your Next.js app: npm run dev
# 3. In another terminal: ngrok http 3000
# 4. Copy the ngrok URL (e.g., https://abc123.ngrok.io)
# 5. Update callback URLs above with the ngrok URL:
#    - MPESA_CALLBACK_URL=https://abc123.ngrok.io/api/webhooks/mpesa
#    - AIRTEL_CALLBACK_URL=https://abc123.ngrok.io/api/webhooks/airtel
#    - PAYSTACK_CALLBACK_URL=https://abc123.ngrok.io/api/webhooks/paystack
# 6. Configure the webhook URL in Paystack dashboard (Settings → Webhooks)
# 
# Note: ngrok URLs change each time you restart it (unless you have a paid plan)

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 
# 1. NEVER commit .env.local to version control
# 2. Keep your secret keys secure
# 3. Rotate keys if compromised
# 4. Use different keys for staging and production
# 5. Implement rate limiting on webhook endpoints
# 6. Always verify webhook signatures (especially Paystack)
# 7. Use HTTPS in production (required by all providers)
# 8. Monitor failed payment attempts
# 9. Set up alerts for unusual activity
# 10. Keep dependencies updated for security patches

