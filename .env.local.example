# =============================================================================
# EVERYTHING SCENTS - ENVIRONMENT VARIABLES (EXAMPLE)
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control
# =============================================================================

# =============================================================================
# NEXT.JS CONFIGURATION
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Everything Scents"

# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Admin SDK (Server-side only)
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# =============================================================================
# M-PESA (SAFARICOM) CONFIGURATION
# =============================================================================
# Daraja API Credentials from https://developer.safaricom.co.ke/
# Use 'sandbox' for testing, 'production' for live
MPESA_ENV=sandbox

# Get these from your Daraja app dashboard
MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here

# Sandbox shortcode: 174379 (provided by Safaricom)
# Production: Your actual business shortcode (paybill/till number)
MPESA_SHORTCODE=174379

# Passkey from Daraja portal (different for sandbox vs production)
MPESA_PASSKEY=your_mpesa_passkey_here

# Webhook URL - where M-Pesa sends payment callbacks
# For local dev, use ngrok: https://your-ngrok-url.ngrok.io/api/webhooks/mpesa
# For production: https://yourdomain.com/api/webhooks/mpesa
MPESA_CALLBACK_URL=https://yourdomain.com/api/webhooks/mpesa

# =============================================================================
# AIRTEL MONEY CONFIGURATION
# =============================================================================
# Airtel Money API Credentials from https://developers.airtel.africa/
# Use 'staging' for testing, 'production' for live
AIRTEL_ENV=staging

# Get these from Airtel Developer Portal
AIRTEL_CLIENT_ID=your_airtel_client_id_here
AIRTEL_CLIENT_SECRET=your_airtel_client_secret_here

# Your Airtel Money merchant/business ID
AIRTEL_MERCHANT_ID=your_merchant_id_here

# Airtel Money business PIN (required for transactions)
AIRTEL_PIN=your_4_digit_pin

# Webhook URL - where Airtel sends payment callbacks
# For local dev, use ngrok: https://your-ngrok-url.ngrok.io/api/webhooks/airtel
# For production: https://yourdomain.com/api/webhooks/airtel
AIRTEL_CALLBACK_URL=https://yourdomain.com/api/webhooks/airtel

# =============================================================================
# PAYSTACK CONFIGURATION
# =============================================================================
# Paystack API Credentials from https://dashboard.paystack.com/
# Test keys start with sk_test_ and pk_test_
# Live keys start with sk_live_ and pk_live_

# Secret key (server-side only) - NEVER expose this
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# Public key (can be used client-side)
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# Webhook URL - configure this in Paystack dashboard
# For local dev, use ngrok: https://your-ngrok-url.ngrok.io/api/webhooks/paystack
# For production: https://yourdomain.com/api/webhooks/paystack
PAYSTACK_CALLBACK_URL=https://yourdomain.com/api/webhooks/paystack

# =============================================================================
# OPTIONAL: SMS & EMAIL NOTIFICATIONS
# =============================================================================
# Africa's Talking or similar SMS provider
SMS_API_KEY=your_sms_api_key
SMS_USERNAME=your_sms_username
SMS_SENDER_ID=EverythingScents

# SendGrid, Mailgun, or SMTP for email
EMAIL_API_KEY=your_email_api_key
EMAIL_FROM=noreply@everythingscents.co.ke
EMAIL_FROM_NAME=Everything Scents

# =============================================================================
# SECURITY & MONITORING
# =============================================================================
# Optional: For webhook IP whitelisting and security
ALLOWED_WEBHOOK_IPS=196.201.214.0/24,196.201.213.0/24

# Optional: Sentry or error tracking
SENTRY_DSN=your_sentry_dsn

# =============================================================================
# NOTES FOR SETUP
# =============================================================================
# 1. M-PESA SETUP:
#    - Go to https://developer.safaricom.co.ke/
#    - Create account and new app
#    - Get Consumer Key and Consumer Secret
#    - Use sandbox shortcode 174379 for testing
#    - Generate passkey from credentials section
#
# 2. AIRTEL MONEY SETUP:
#    - Go to https://developers.airtel.africa/
#    - Register your business
#    - Get Client ID, Client Secret, Merchant ID
#    - Contact Airtel for PIN
#
# 3. PAYSTACK SETUP:
#    - Go to https://dashboard.paystack.com/
#    - Sign up and verify your business
#    - Navigate to Settings → API Keys & Webhooks
#    - Copy test keys (sk_test_ and pk_test_)
#    - Configure webhook URL in dashboard
#
# 4. NGROK FOR LOCAL TESTING:
#    npm install -g ngrok
#    npm run dev (in one terminal)
#    ngrok http 3000 (in another terminal)
#    Use the ngrok URL for all callback URLs
#
# 5. PRODUCTION CHECKLIST:
#    - Change all _ENV values to 'production'
#    - Replace test keys with live keys
#    - Use HTTPS for all callback URLs
#    - Configure webhooks in provider dashboards
#    - Test with small amounts first
# =============================================================================
